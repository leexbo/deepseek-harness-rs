#!/usr/bin/env bash
# verify-e2e:端到端链路测试(假 provider 驱动,不依赖真实网络)
# turn 主链路 + 工具/沙箱闭环 + 审计归因重放(E5)。
# 随迁测试覆盖:liuma-llm provider 契约(adapters)、liuma-sandbox 进程/沙箱、
# liuma-tools 工具闭环(HTTP mock 全链)。
set -euo pipefail
cd "$(dirname "$0")/.."
cargo test -p liuma-host --test e2e_turn --test audit
cargo test -p liuma-tools --test tool_loop --test cli_tool_e2e
cargo test -p liuma-llm --test adapters
cargo test -p liuma-sandbox
